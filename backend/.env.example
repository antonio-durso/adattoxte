# Adatto x Te - Backend configuration
# Copy this file to .env and fill in the values.

# Server port (default 3001)
PORT=3001

# Secret for JWT tokens - CHANGE THIS in production (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Public URL of the frontend (used by Stripe redirects after payment)
FRONTEND_URL=http://localhost:5173

# --- Stripe (optional - the platform works in DEMO MODE without these) ---
# To enable real payments: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIVIDUAL=price_xxx
STRIPE_PRICE_COUPLE=price_xxx

# PayPal via Stripe: set to 1 ONLY after enabling PayPal in the Stripe
# Dashboard (Settings -> Payment methods). Available for EU businesses (Italy included).
STRIPE_PAYPAL_ENABLED=
