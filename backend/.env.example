# Adatto x Te - Backend configuration
# Copy this file to .env and fill in the values.

# Server port (default 3001)
PORT=3001

# Secret for JWT tokens - CHANGE THIS in production (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Public URL of the frontend (used by Stripe redirects after payment)
FRONTEND_URL=http://localhost:5173

# --- PayPal (optional - the platform works in DEMO MODE without these) ---
# Crea un'app su https://developer.paypal.com/dashboard/applications per
# ottenere Client ID e Secret. I fondi vengono accreditati sul conto PayPal
# Business collegato (es. annapalladino888@gmail.com). Per accettare carte
# attiva "Advanced Card Processing" (Elaborazione avanzata delle carte).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (test) oppure live (pagamenti reali)
PAYPAL_MODE=sandbox
